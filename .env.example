# Application
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ENV=development

# Secret key - auto-generated on first run if left blank
APP_SECRET_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Microsoft Graph (OAuth - register your app at Azure Portal)
# MSGRAPH_CLIENT_ID=
# MSGRAPH_TENANT_ID=
# MSGRAPH_REDIRECT_URI=http://localhost:8765/api/v1/auth/msgraph/callback

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
