# Application
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ENV=development

# Secret key - auto-generated on first run if left blank
APP_SECRET_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ──────────────────────────────────────────────
# FILL THESE IN — do NOT paste them in chat
# Copy this file to .env and add your real values
# ──────────────────────────────────────────────

# CapSolver (client-provided)
CAPTCHA_PROVIDER=capsolver
CAPSOLVER_API_KEY=your-capsolver-key-here

# CAPTCHA policy — set to true when ready to go live
CAPTCHA_SOLVE_ENABLED=false

# Dedicated proxy (client-provided)
# Format: http://user:pass@host:port or socks5://host:port
PROXY_URL=http://your-proxy-here:port

# SMS Provider (client-provided — ask which service)
# Supported: 5sim, smspva, sms-activate, etc.
SMS_PROVIDER_NAME=generic
SMS_PROVIDER_API_KEY=your-sms-key-here
SMS_PROVIDER_BASE_URL=https://api.your-sms-provider.com

# Microsoft Graph (for BNet email verification)
# Client provides mailbox creds in mail:pass:clientId:authToken format
# These are imported via the Mailbox page, not set here.
# Only needed if using OAuth app-level flow:
# MSGRAPH_CLIENT_ID=
# MSGRAPH_TENANT_ID=
MSGRAPH_REDIRECT_URI=http://localhost:8765/api/v1/auth/msgraph/callback

# Other CAPTCHA providers (leave blank if not using)
ANTICAPTCHA_API_KEY=
TWOCAPTCHA_API_KEY=
EZCAPTCHA_API_KEY=

# Browser automation
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Worker / queue limits
MAX_WORKER_COUNT=10
MAX_QUEUE_SIZE=1000
JOB_TIMEOUT_SECONDS=300
MAX_RETRIES=3
IMPORT_MAX_ROWS=10000
BACKUP_RETENTION_DAYS=30
